PORT=10000

# Option A — Standard connection (recommended on Windows if mongodb+srv fails with querySrv ECONNREFUSED)
# Atlas → Connect → Drivers → copy "Standard connection string" and replace <password>/<dbname>
MONGO_URL=mongodb://USER:PASSWORD@host1:27017,host2:27017,host3:27017/bluepeak?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority

# Option B — SRV connection (works when DNS supports SRV records)
# MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/bluepeak?retryWrites=true&w=majority

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
# Cloudinary — restrict dashboard access; enable PDF/ZIP delivery only if needed
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# NODE_ENV=production enables Secure auth cookies, TLS checks, and production CORS
NODE_ENV=development
SITE_URL=https://bluepeakstudio.in
# Optional comma-separated extra CORS origins (e.g. preview deploy URLs)
# CORS_EXTRA_ORIGINS=
ADMIN_SEED_EMAIL=admin@bluepeakstudio.in
ADMIN_SEED_PASSWORD=change-this-strong-password
# Optional display name for the bootstrap admin
ADMIN_SEED_NAME=BluePeak Admin
# Set to true once after wiping the DB to recreate or sync the admin password on deploy (no shell needed on Render)
ADMIN_SEED_RESET=false
# Secret for POST /api/admin/jobs/billing-cycle (daily recurring invoice sync)
BILLING_JOB_SECRET=
